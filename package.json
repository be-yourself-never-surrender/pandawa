{
  "name": "pandawa",
  "version": "7.0.0",
  "description": "Pandawa OS — Hardened Hybrid TypeScript + Python Living Agentic Team OS with Visual [[Wikilink]] Brains, xterm.js PTY Terminals, Programmatic Execute & Verify & Multi-AI Routing",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "pandawa": "dist/server/cli.js"
  },
  "scripts": {
    "dev:server": "node --watch --experimental-strip-types server/src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:server && npm run build:web",
    "test": "node --test server/tests/*.test.mjs",
    "test:web": "node --experimental-strip-types --test web/tests/*.test.mjs",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.2"
  }
}
